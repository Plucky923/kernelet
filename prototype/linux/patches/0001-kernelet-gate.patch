kernelet gate: two hooks in the generic entry layer, a task_struct pointer,
a syscall-work bit, a helper for changing a user task's address space, one for
allocating a tenant process's address space, and the two exports an endovisor
module needs that Linux does not already make: kernel_clone, and
flush_tlb_mm_range for the synchronous flush of vm_flush.

Signed-off-by: kernelet-in-Linux prototype <none@example.com>
---
--- /dev/null
+++ b/include/linux/kernelet.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The kernelet gate: the two places where a Linux task that carries a
+ * kernelet task (a "carrier") diverts out of the generic entry layer and
+ * into the endovisor.
+ *
+ * A carrier has a non-NULL current->kernelet.  The pointer is inherited by
+ * dup_task_struct() like every other task_struct field, so a child is a
+ * carrier before it exists; the endovisor replaces it with the child's own
+ * record as the first thing the child does.
+ */
+#ifndef _LINUX_KERNELET_H
+#define _LINUX_KERNELET_H
+
+struct pt_regs;
+
+struct kernelet_gate_ops {
+	/*
+	 * Called from syscall_trace_enter(), after seccomp, for a system call
+	 * issued by a carrier's user mode; regs hold the number and the
+	 * arguments.  Returns true if the kernelet serviced the call: regs
+	 * then hold what the task returns to user mode with, return value
+	 * included, and Linux's own dispatch is skipped entirely.  Returns
+	 * false to let Linux dispatch the call as for any other task.
+	 */
+	bool (*on_syscall)(struct pt_regs *regs);
+
+	/*
+	 * Called from exit_to_user_mode_loop(), after the TIF_NOTIFY_RESUME
+	 * work and before signals are delivered, whenever a carrier is about
+	 * to return to user mode with exit work pending: for a reason of the
+	 * kernelet's own (a carrier's first entry, a tenant's fault, a
+	 * virtual interrupt) or for one of Linux's (a reschedule, a signal).
+	 * No reason is passed, and several may be pending at once: whoever
+	 * requested the call recorded why in the endovisor's record for the
+	 * task, and the hook reads it there.  The loop may call it more than
+	 * once on one return.
+	 *
+	 * Runs in process context with no lock held; it may sleep, and may
+	 * run kernelet code for as long as it likes.  It may rewrite regs,
+	 * which are what the task returns to user mode with, and must leave
+	 * them alone when it has nothing to do.
+	 */
+	void (*on_resume)(struct pt_regs *regs);
+};
+
+struct kernelet_gate {
+	const struct kernelet_gate_ops *ops;
+};
+
+/*
+ * Makes the current *user* task run in `mm`.  A carrier carries a virtual CPU
+ * and runs many tenant threads, so its address space is not its own: it is the
+ * address space of the tenant process the kernelet has activated on that
+ * virtual CPU, and it changes.  Consumes one mm_users reference on `mm` and
+ * returns the mm the task was in, whose reference the caller must drop.
+ */
+struct mm_struct;
+struct mm_struct *kernelet_switch_mm(struct mm_struct *mm);
+
+/*
+ * kernelet_mm_alloc - mm_alloc() with @owner as its owner, added once to the
+ * memory cgroup's multi-generational LRU list; a tenant process's mm.
+ */
+struct task_struct;
+struct mm_struct *kernelet_mm_alloc(struct task_struct *owner);
+
+#endif /* _LINUX_KERNELET_H */
