+#ifdef CONFIG_KERNELET
+/**
+ * kernelet_mm_alloc - a fresh address space for a kernelet's tenant process
+ * @owner: the task the memory controller charges it to: the sandbox's root
+ *	carrier, which the caller keeps pinned (get_task_struct()) for as long
+ *	as the mm may run, and clears from the mm before it unpins it
+ *
+ * mm_alloc(), the owner, and the one addition to the memory cgroup's
+ * multi-generational LRU list that exec_mmap() and fork make for an mm.  The
+ * owner comes first, because lru_gen_add_mm() resolves the cgroup through it.
+ * mm_init() would have made the calling carrier the owner, without a
+ * reference, and Linux moves the ownership only when that task exits with
+ * this mm as its own, which a carrier that made the space and switched back
+ * never does.  The addition is made here, once, and never per adoption:
+ * lru_gen_add_mm() of an mm already on the list corrupts the list.
+ */
+struct mm_struct *kernelet_mm_alloc(struct task_struct *owner)
+{
+	struct mm_struct *mm = mm_alloc();
+
+	if (!mm)
+		return NULL;
+#ifdef CONFIG_MEMCG
+	WRITE_ONCE(mm->owner, owner);
+#endif
+	lru_gen_add_mm(mm);
+	return mm;
+}
+EXPORT_SYMBOL_GPL(kernelet_mm_alloc);
+
+/**
+ * kernelet_switch_mm - make the current *user* task run in @mm
+ * @mm: the address space to adopt; the caller's mm_users reference is consumed
+ *
+ * Modelled on exec_mmap(), for a task that already has an mm and will change it
+ * again.  An endovisor uses it to put a kernelet's virtual-CPU carrier into the
+ * address space of the tenant process the kernelet has activated on that
+ * virtual CPU; a carrier runs many tenant threads, of more than one tenant
+ * process, so which address space that is changes.
+ *
+ * Returns the mm the task was in, whose mm_users reference now belongs to the
+ * caller, to drop in sleepable context.  tsk->mm and tsk->active_mm stay equal,
+ * which is what exit_mm() asserts, and exit_mm() then drops the reference on
+ * whatever the task ended up in.
+ *
+ * The concurrency-id brackets are not optional: a carrier is a user task with
+ * mm_cid_active set, so swapping tsk->mm without releasing the old mm's cid
+ * would leak one bit of its mm_cidmask per adoption, and after nr_cpu_ids leaks
+ * __mm_cid_try_get() spins for ever under the runqueue lock.
+ */
+struct mm_struct *kernelet_switch_mm(struct mm_struct *mm)
+{
+	struct task_struct *tsk = current;
+	struct mm_struct *old_mm;
+
+	if (WARN_ON_ONCE(!tsk->mm))
+		return NULL;
+	if (tsk->mm == mm)
+		return mm;
+
+	sched_mm_cid_before_execve(tsk);
+
+	task_lock(tsk);
+	local_irq_disable();
+	old_mm = tsk->active_mm;
+	tsk->active_mm = mm;
+	tsk->mm = mm;
+	membarrier_update_current_mm(mm);
+	switch_mm_irqs_off(old_mm, mm, tsk);
+	local_irq_enable();
+	task_unlock(tsk);
+	lru_gen_use_mm(mm);
+
+	sched_mm_cid_after_execve(tsk);
+
+	return old_mm;
+}
+EXPORT_SYMBOL_GPL(kernelet_switch_mm);
+#endif
