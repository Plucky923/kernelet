+config KERNELET
+	bool "Kernelet gate (Asterinas kernelets in kernel mode)"
+	depends on GENERIC_ENTRY && X86_64
+	select PREEMPT_NOTIFIERS
+	help
+	  Adds two hooks to the generic syscall entry and exit-to-user-mode
+	  paths, a task_struct pointer and a helper for changing the address
+	  space of a user task, through which a loadable endovisor can carry
+	  Asterinas kernelet virtual CPUs on ordinary Linux tasks.  A task with
+	  a NULL current->kernelet, which is every task on a machine with no
+	  endovisor loaded, is unaffected.
+
+	  If unsure, say N.
+
 endmenu		# General setup
 
