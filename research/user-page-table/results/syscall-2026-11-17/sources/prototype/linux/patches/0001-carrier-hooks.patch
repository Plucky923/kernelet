+#ifdef CONFIG_KERNELET
+// Releases old userspace registrations once, before direct carrier execution.
+// This is the attach commit point; failures after it must terminate the task.
+struct mm_struct *kernelet_attach_mm(struct mm_struct *mm)
+{
+	struct task_struct *tsk = current;
+	struct mm_struct *old_mm;
+
+	io_uring_task_cancel();
+#ifdef CONFIG_POSIX_TIMERS
+	spin_lock_irq(&tsk->sighand->siglock);
+	posix_cpu_timers_exit(tsk);
+	spin_unlock_irq(&tsk->sighand->siglock);
+	exit_itimers(tsk);
+	flush_itimer_signals();
+#endif
+	user_events_execve(tsk);
+	exec_mm_release(tsk, tsk->mm);
+	clear_syscall_work_syscall_user_dispatch(tsk);
+	sas_ss_reset(tsk);
+	rseq_execve(tsk);
+	flush_thread();
+	old_mm = kernelet_switch_mm(mm);
+	if (old_mm)
+		mm_update_next_owner(old_mm);
+	return old_mm;
+}
+EXPORT_SYMBOL_GPL(kernelet_attach_mm);
+#endif
 
