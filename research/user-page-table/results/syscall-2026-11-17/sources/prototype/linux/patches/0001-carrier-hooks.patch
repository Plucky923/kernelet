+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Carrier event hooks divert entry handling and task exit to the endovisor
+ * for a Linux task carrying a kernelet's virtual CPU (a "carrier").
+ *
+ * A carrier has a non-NULL current->carrier_hooks.  The pointer is
+ * inherited by dup_task_struct() like every other task_struct field, so a
+ * child is a carrier before it exists; the endovisor replaces it with the
+ * child's own table as the first thing the child does.
+ */
+#ifndef _LINUX_KERNELET_H
+#define _LINUX_KERNELET_H
+
+#include <linux/compiler_attributes.h>
+#include <linux/percpu.h>
+#include <linux/types.h>
+
+struct mm_struct;
+struct pt_regs;
+struct task_struct;
+
+struct carrier_event_hooks {
+	/*
+	 * Called from syscall_trace_enter(), after seccomp, for a system call
+	 * issued by a carrier's user mode; regs hold the number and the
+	 * arguments.  Returns true if the kernelet serviced the call: regs
+	 * then hold what the task returns to user mode with, return value
+	 * included, and Linux's own dispatch is skipped entirely.  Returns
+	 * false to let Linux dispatch the call as for any other task.
+	 */
+	bool (*on_syscall)(struct pt_regs *regs);
+
+	/*
+	 * Called from exit_to_user_mode_loop(), after the TIF_NOTIFY_RESUME
+	 * work and before signals are delivered, whenever a carrier is about
+	 * to return to user mode with exit work pending: for a reason of the
+	 * kernelet's own (a carrier's first entry, a tenant's fault, a
+	 * virtual interrupt) or for one of Linux's (a reschedule, a signal).
+	 * No reason is passed, and several may be pending at once: whoever
+	 * requested the call recorded why in the endovisor's record for the
+	 * task, and the hook reads it there.  The loop may call it more than
+	 * once on one return.
+	 *
+	 * Runs in process context with no lock held; it may sleep, and may
+	 * run kernelet code for as long as it likes.  It may rewrite regs,
+	 * which are what the task returns to user mode with, and must leave
+	 * them alone when it has nothing to do.
+	 */
+	void (*on_resume)(struct pt_regs *regs);
+
+	// Optional hook invoked on forwarded user-mode exceptions (`#DE`, `#DB`, `#BP`, `#OF`, `#UD`, `#SS`, `#GP`, `#PF`, `#MF`, `#AC`, `#XM`).
+	//
+	// Returns `true` if the kernelet consumed the exception, or `false` to fall back to Linux's normal trap/signal delivery.
+	bool (*on_exception)(struct pt_regs *regs, unsigned int trapnr,
+			     unsigned long error_code, unsigned long addr);
+
+	// Optional hook invoked on unrecovered kernel-mode `#PF` or `#GP` faults after `fixup_exception()` fails.
+	//
+	// Returns `true` if the kernelet fixed up `regs` (for example via its own `ex_table`), or `false` to proceed with Linux oops/die handling.
+	bool (*on_kernel_fault)(struct pt_regs *regs, unsigned int trapnr,
+				unsigned long error_code, unsigned long addr);
+
+	// Detaches carrier callbacks in the exiting task before its files close.
+	// `current->mm` has already been released; this hook must not switch address spaces.
+	void (*on_exit)(void);
+};
+
+// Per-CPU identity slot for fast `%gs:`-relative lookup of the active kernelet and vCPU.
+struct kernelet_cpu_slot {
+	u16 kernelet;
+	u16 vcpu;
+	u32 generation;
+	u64 _reserved;
+};
+
+DECLARE_PER_CPU_ALIGNED(struct kernelet_cpu_slot, kernelet_cpu_slot);
+
+u32 kernelet_cpu_slot_gs_offset(void);
+
+// Completes Linux exit-to-user-mode work for `regs` and returns to Ring 3 via `SYSRET` or `IRET`.
+void kernelet_return_to_user(struct pt_regs *regs, bool from_syscall) __noreturn;
+
+// Restores a carrier task's lazy FPU register state if `TIF_NEED_FPU_LOAD` is set.
+void kernelet_fpu_restore_carrier(void);
+
+// Restores a carrier task's FPU registers inside a preempt-notifier `sched_in` callback with IRQs off.
+void kernelet_fpu_sched_in(void);
+
+// Reinitializes hardware FPU registers and marks `current->thread.fpu` active after a `#GP` fixup.
+void kernelet_fpu_reset_carrier(void);
+
+extern void mmput_async(struct mm_struct *mm);
+
+/*
+ * Makes the current *user* task run in `mm`.  A carrier carries a virtual CPU
+ * and runs many tenant threads, so its address space is not its own: it is the
+ * address space of the tenant process the kernelet has activated on that
+ * virtual CPU, and it changes.  Consumes one mm_users reference on `mm` and
+ * returns the mm the task was in, whose reference the caller must drop.
+ */
+struct mm_struct *kernelet_switch_mm(struct mm_struct *mm);
+
+// Commits a direct carrier attach, releasing registrations tied to its old userspace.
+// The caller must finish all fallible preparation before calling this helper.
+// Consumes the new `mm` reference and returns the old reference as `kernelet_switch_mm` does.
+struct mm_struct *kernelet_attach_mm(struct mm_struct *mm);
+
+/*
+ * kernelet_mm_alloc - mm_alloc() with @owner as its owner, added once to the
+ * memory cgroup's multi-generational LRU list; a tenant process's mm.
+ */
+struct mm_struct *kernelet_mm_alloc(struct task_struct *owner);
+
+#endif /* _LINUX_KERNELET_H */
