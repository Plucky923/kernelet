-        if let Some(detail) = &shared.failure {
-            bail!("{detail}");
-        }
-        if let Some(detail) = shared.input_errors.remove(id) {
-            bail!("{detail}");
-        }
-        ensure!(
-            shared.input_ready.contains(id),
-            "process exited before stdin acknowledgement"
-        );
-        Ok(())
-    }
