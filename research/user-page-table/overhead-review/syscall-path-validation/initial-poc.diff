-        = B::Transmit<'a>
-    where
-        Self: 'a;
-    fn receive(&mut self, _: NetworkInstant) -> Option<(Receive<B::Frame>, B::Transmit<'_>)> {
-        self.received.as_ref()?;
-        let transmit = self.backend.receive_transmit()?;
-        self.prepared_udp = None;
