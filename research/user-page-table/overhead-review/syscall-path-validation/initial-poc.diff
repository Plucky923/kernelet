-        state,
-        reason: STATUS_REASON_NONE,
-        code: 0,
-        flags: 0,
-        uptime_ns: 0,
-        cpu_time_ns: kernelet_abi::STATS_UNAVAILABLE,
-        fault_addr: 0,
-        fault_ip: 0,
-        message_len: 0,
