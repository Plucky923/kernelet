-impl CloseWorker {
-    fn global() -> Arc<Self> {
-        CLOSE_WORKER
-            .call_once(|| {
-                let worker = Arc::new(Self {
-                    pending: Mutex::new(VecDeque::new()),
-                    changes: WaitQueue::new(),
-                    generation: AtomicU64::new(0),
