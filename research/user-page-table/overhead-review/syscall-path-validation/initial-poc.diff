-/// Accepted work. Dropping it requests cancellation and discards its result;
-/// storage remains retained until every backend access and callback ends.
-pub struct PendingIo {
-    token: u64,
-    returned: Option<(i64, u64)>,
-}
-
-impl PendingIo {
