-        request_id: u64,
-        id: u64,
-        signal: i32,
-    },
-    CloseInput {
-        request_id: u64,
-        id: u64,
-    },
-    Data {
-        id: u64,
-        stream: Stream,
-        data: Vec<u8>,
-    },
-    Close {
-        id: u64,
-        stream: Stream,
-    },
-    Exited {
-        id: u64,
