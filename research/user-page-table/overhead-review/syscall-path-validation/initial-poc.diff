-fn hash_tree(root: &Path, path: &Path, digest: &mut Sha256) -> Result<u64> {
-    hash_tree_inner(
-        &SourceNode::open(path)?,
-        path.strip_prefix(root)?,
-        digest,
-        &mut BTreeMap::new(),
-    )
-}
