-            counts: [const { AtomicU64::new(0) }; N],
-            writers: AtomicU64::new(0),
-            generation: AtomicU64::new(0),
-            overflow: AtomicBool::new(false),
-            identity: AtomicU64::new(0),
-        }
-    }
