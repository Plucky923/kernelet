-            paddr: u64::from_le_bytes(bytes[0..8].try_into().unwrap()),
-            len: u32::from_le_bytes(bytes[8..12].try_into().unwrap()),
-            flags: u16::from_le_bytes(bytes[12..14].try_into().unwrap()),
-            next: u16::from_le_bytes(bytes[14..16].try_into().unwrap()),
-        }
-    }
-
