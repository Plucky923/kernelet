-            resources
-                .grant
-                .grow_and_raise_ceiling(grains, 0)
-                .map_err(|error| match error {
-                    Error::Overflow => GrantError::MetadataCapacity,
-                    Error::NoMemory => GrantError::NoMemory,
-                    _ => GrantError::Limit,
