-const RQ1_IO_ANNOTATION: &str = "org.asterinas.kernelet.rq1-io";
-const RQ1_RAM_BYTES: u64 = 4 * 1024 * 1024;
-const RQ1_RAM_MAGIC: &[u8] = b"KerneletRQ1RAMv1";
