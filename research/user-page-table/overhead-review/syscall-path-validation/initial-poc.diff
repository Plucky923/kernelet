-/// Owns sandbox cleanup from creation until the holder accepts the descriptors.
-struct SandboxCleanup {
-    sandbox: Sandbox,
-    armed: bool,
-}
-
-impl Drop for SandboxCleanup {
-    fn drop(&mut self) {
-        if self.armed {
-            let _ = self.sandbox.kill(0);
-            let _ = self.sandbox.destroy();
-        }
-    }
-}
