-        &self,
-        event: NatEvent,
-        context: NatContext,
-        errno: Option<Errno>,
-        host_error: Option<ostd::Error>,
-        requested_bytes: usize,
-        quota: Option<NatQuotaSnapshot>,
-        cancelled: bool,
