-        UnixStream::connect(directory.join("control.sock")).context("connect to sandbox holder")?;
-    stream.set_read_timeout(Some(CONTROL_TIMEOUT))?;
-    protocol::send_value(&mut stream, operation)?;
-    Ok(stream)
-}
