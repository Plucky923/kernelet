-/// A status record for an instance killed by the Host with `code`.
-pub(super) fn killed_status(code: u32) -> StatusRaw {
-    let mut status = blank_status(STATE_EXITED);
-    status.reason = STATUS_REASON_KILLED;
-    status.code = code;
-    status
-}
