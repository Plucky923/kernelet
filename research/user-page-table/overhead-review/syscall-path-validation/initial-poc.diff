-// SPDX-License-Identifier: MPL-2.0
-
-//! Optional CPU attribution for device completion and receive-copy work.
-
-#[cfg(not(kernelet_rq1_diagnostics))]
-use core::marker::PhantomData;
-
-use ostd::kernelet::control::Kernelet;
