-            let record = resources.instance.vcpu_record_address() as *const VcpuRecord;
-            // SAFETY: The admitted operation retains all instance mappings.
-            unsafe { &*record }
-                .pending
-                .fetch_or(super::abi::VIRQ_KICK, Ordering::Release);
