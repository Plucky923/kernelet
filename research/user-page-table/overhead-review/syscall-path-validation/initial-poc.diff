-fn recoverable_read(error: usize, address: usize, range: Range<usize>) -> bool {
-    let allowed = (PageFaultErrorCode::PRESENT | PageFaultErrorCode::PROTECTION).bits();
-    error & !allowed == 0 && range.start != 0 && range.contains(&address)
-}
