-        for (index, condition) in [
-            flow.host.is_some(),
-            flow.guest_eof,
-            flow.host_eof,
-            flow.alive,
-            flow.requested.is_some(),
-            flow.requested.is_none(),
-            !flow.to_host.is_empty(),
-            socket.recv_queue() != 0,
-            socket.send_queue() != 0,
-        ]
-        .into_iter()
-        .enumerate()
