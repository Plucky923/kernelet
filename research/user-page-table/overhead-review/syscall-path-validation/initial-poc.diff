-        layout,
-        kind,
-        bytes,
-        duration_ns,
-        submitted_bios,
-        cpu: cpu.into(),
-        elapsed_ticks,
-        logical_elapsed_ticks,
-        bio_duration_ns,
-        logical_duration_ns,
-        clock_hz,
-        payload_segments: measured_pages.len(),
-        bytes_per_bio,
-        segments_per_bio,
-    })
-}
