-            budget -= 1;
-            let slot = r.last_avail as u32 % r.queue_num;
-            let Some(head_addr) = r.avail.checked_add(4 + slot as u64 * 2) else {
-                r.status |= DEVICE_NEEDS_RESET;
-                break;
-            };
-            let Ok(head) = self.read_u16(head_addr) else {
-                r.status |= DEVICE_NEEDS_RESET;
