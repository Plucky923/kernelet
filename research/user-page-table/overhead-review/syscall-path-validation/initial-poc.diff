-            drop(destroy_accepted);
-            protocol::send_value(&mut connection, &Reply::Done)?;
-            holder.stopping.store(true, Ordering::Release);
-            let _ = UnixStream::connect(&holder.socket_path);
-        }
-    }
-    Ok(())
-}
