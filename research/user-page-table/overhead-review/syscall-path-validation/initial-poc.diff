-    /// Waits for stdin writability without ever blocking past the deadline.
-    fn wait_writable(&self, stdin: &ChildStdin) -> Result<()> {
-        let remaining = self.remaining()?;
-        let mut descriptor = libc::pollfd {
-            fd: stdin.as_raw_fd(),
-            events: libc::POLLOUT,
-            revents: 0,
