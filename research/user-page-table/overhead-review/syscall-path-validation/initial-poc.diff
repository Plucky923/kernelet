-        )
-        .unwrap();
-        let _consumer = OpenOptions::new()
-            .read(true)
-            .custom_flags(libc::O_NONBLOCK)
-            .open(&stdout)
-            .unwrap();
-        nix::fcntl::fcntl(
-            _consumer.as_raw_fd(),
-            nix::fcntl::FcntlArg::F_SETPIPE_SZ(4096),
-        )
-        .unwrap();
-        let process = ProcessRecord {
-            stdin: stdin.to_str().unwrap().into(),
-            stdout: stdout.to_str().unwrap().into(),
-            ..running_process()
