-        second_root.write_bytes(0, bytes).unwrap();
-        for (request, value) in KERNELET_TEST_ROOTS.iter().zip([
-            root.paddr(),
-            second_root.paddr(),
-            root.paddr(),
-            root.paddr(),
-            1,
-            0,
-            root.paddr(),
