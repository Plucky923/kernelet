-fn receive_reply(stream: &mut UnixStream) -> Result<Reply> {
-    let reply: Reply = protocol::receive_value(stream)?;
-    if let Reply::Error(message) = &reply {
-        bail!("{message}");
-    }
-    stream.set_read_timeout(None)?;
-    Ok(reply)
-}
