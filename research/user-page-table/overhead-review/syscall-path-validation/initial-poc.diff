-        let align = if matches!(allocation, RunAllocation::Initial)
-            && count as usize == GRAINS_PER_SECTION
-        {
-            META_SECTION_BYTES
-        } else if count.is_power_of_two() {
-            bytes
-        } else {
-            GRAIN_SIZE
-        };
