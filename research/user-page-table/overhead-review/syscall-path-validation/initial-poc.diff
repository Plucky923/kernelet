-    /// Applies a queue table address write (`QueueDesc`, `QueueAvail` or
-    /// `QueueUsed`, low or high word); refused while the queue is ready.
-    pub(super) fn set_address_register(&mut self, offset: u32, value: u32) -> bool {
-        if self.ready {
-            return false;
-        }
