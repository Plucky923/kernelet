-        if result.is_ok() {
-            self.control
-                .account
-                .grant_overhead
-                .fetch_max(resources.grant.overhead_bytes(), Ordering::Relaxed);
-            self.control
-                .account
-                .grains
-                .fetch_max(resources.grant.grains(), Ordering::Release);
-            self.control
-                .account
-                .ceiling
-                .fetch_max(resources.grant.ceiling(), Ordering::Release);
