-#[derive(Clone, Debug, Deserialize, Serialize)]
-pub enum Message {
-    Hello {
-        version: u32,
-    },
-    Prepare {
-        config: Box<Config>,
-    },
-    Prepared,
-    ListProcesses {
-        request_id: u64,
