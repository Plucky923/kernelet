-    if hex.len() != 64 {
-        return Err(Error::InvalidArgs);
-    }
-    let mut hash = [0; 32];
-    for (byte, digits) in hash
-        .iter_mut()
-        .zip(hex.as_bytes().as_chunks::<2>().0.iter())
-    {
-        let high = hex_digit(digits[0]).ok_or(Error::InvalidArgs)?;
-        let low = hex_digit(digits[1]).ok_or(Error::InvalidArgs)?;
-        *byte = (high << 4) | low;
-    }
-    Ok(hash)
-}
