-    fn connect_events(&self) -> IoEvents {
-        let state = self.lock_state();
-        if state.reset || self.revoked.load(Ordering::Acquire) {
-            IoEvents::ERR
-        } else if state.connected {
-            IoEvents::OUT
-        } else {
-            IoEvents::empty()
