-struct Measurement {
-    layout: Layout,
-    kind: BioType,
-    bytes: usize,
-    duration_ns: u64,
-    submitted_bios: usize,
-    cpu: u32,
-    elapsed_ticks: Vec<u64>,
-    logical_elapsed_ticks: Vec<u64>,
-    bio_duration_ns: u64,
-    logical_duration_ns: u64,
-    clock_hz: u64,
-    payload_segments: usize,
-    bytes_per_bio: Vec<usize>,
-    segments_per_bio: Vec<usize>,
